{
  "expo": {
    "name": "PET Helper",
    "slug": "pet-helper",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.glitchfl.pethelper",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      "expo-sqlite",
      "expo-image"
    ],
    "scheme": "pet-helper",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "84ac06b1-1f0e-402f-a4c3-44a64155a2c9"
      }
    },
    "owner": "glitchfl",
    "updates": {
      "url": "https://u.expo.dev/84ac06b1-1f0e-402f-a4c3-44a64155a2c9"
    }
  }
}
